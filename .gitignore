# Entornos y caché de Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Datos pesados, tensores y pesos binarios
data/raw/*
!data/raw/.gitkeep
data/features/*
!data/features/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/weights/*
!models/weights/.gitkeep
models/onnx/*
!models/onnx/.gitkeep

# Logs y métricas temporales
logs/*
!logs/.gitkeep
results/metrics/*.json
results/metrics/*.csv
!results/metrics/.gitkeep
